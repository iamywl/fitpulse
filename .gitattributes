# Auto-detect text files and perform LF normalization on checkout
* text=auto eol=lf

# Explicitly declare files that must have LF line endings
*.sh text eol=lf
*.conf text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
.gitignore text eol=lf
.dockerignore text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
